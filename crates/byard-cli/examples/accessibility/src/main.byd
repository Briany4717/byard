// RFC-0042, the accessibility tree.
//
// Run it (from the repo root):
//   cargo run -p byard-cli -- shot crates/byard-cli/examples/accessibility --a11y tree.txt
//
// That writes the tree a screen reader is given, as text, with no screen
// reader, no D-Bus and no window: one node a line, with its role, name, value,
// state and bounds. The committed copy is `tree.txt` beside this file, and
// `tests/it/accessibility_example.rs` compares the two. To hear it instead,
// run the app with `byard dev` under Orca (Linux), NVDA or Narrator (Windows)
// or VoiceOver (macOS) and move through it with Tab.
//
// What to look for in the dump:
//   1. "Save" is a Button named by its own text, and the text is not listed a
//      second time as a node of its own.
//   2. The first icon button is named "Close" by `a11y_label:`. Its icon is
//      `a11y_hidden: true`, decoration taken out of the tree.
//   3. The second icon button is the one deliberately left without a name, and
//      the dump says so: `Button (unnamed)`. That is where an `a11y_label:` is
//      missing, and a reader would say only "button".
//   4. The Toggle, the Checkbox and each RadioButton are named by the Text
//      beside them in their Row, and that Text is not listed again (a reader
//      would say "Wi-Fi" twice); the Slider by its `a11y_label:`; the
//      TextField by its placeholder.
//   5. The hero image is not in the tree at all (`a11y_hidden: true`), and
//      every Row, Column and Box between the controls is gone: the tree is
//      the controls.
//   6. The values: the Toggle is `on`, the Slider `0.5 in 0..1 step 0.25`, the
//      Checkbox is not checked, the "Pro" radio button is.
View Main() {
    var wifi = true
    var agree = false
    var plan = "pro"
    var volume = 0.5
    var query = ""
    var saved = 0

    Column #[bg: 0x14141C, p: 24, gap: 14, width: 400, grow: 1] {
        Text("Accessibility, RFC-0042") #[font: body, color: 0xE6E1E5, size: 20, width: 352]
        Image("src/hero.png") #[width: 352, height: 48, a11y_hidden: true]

        Row #[gap: 10] {
            Button("Save") #[font: body, width: 90, height: 36, bg: 0x3B82F6, radius: 8] => saved = saved + 1
            // Icon only: the label is what a screen reader says.
            Box #[a11y_label: "Close", width: 36, height: 36, bg: 0x2A2A36, radius: 8, align: center, justify: center, tap => saved = 0] {
                VectorIcon("src/close.svg") #[size: 18, color: 0xFFFFFF, a11y_hidden: true]
            }
            // The same button with nothing to say what it does.
            Box #[width: 36, height: 36, bg: 0x2A2A36, radius: 8, align: center, justify: center, tap => saved = 0] {
                VectorIcon("src/close.svg") #[size: 18, color: 0xFFFFFF, a11y_hidden: true]
            }
        }

        Row #[gap: 12, align: center] {
            Toggle #[bind: wifi, width: 52, height: 30]
            Text("Wi-Fi") #[font: body, color: 0xCAC4D0, size: 16, width: 200]
        }
        Row #[gap: 12, align: center] {
            Checkbox #[bind: agree, width: 24, height: 24]
            Text("Remember me") #[font: body, color: 0xCAC4D0, size: 16, width: 200]
        }
        Row #[gap: 12, align: center] {
            RadioButton #[bind: plan, value: "free", width: 24, height: 24]
            Text("Free") #[font: body, color: 0xCAC4D0, size: 16, width: 200]
        }
        Row #[gap: 12, align: center] {
            RadioButton #[bind: plan, value: "pro", width: 24, height: 24]
            Text("Pro") #[font: body, color: 0xCAC4D0, size: 16, width: 200]
        }

        Slider #[bind: volume, min: 0, max: 1, step: 0.25, width: 352, height: 28, a11y_label: "Volume"]
        TextField #[bind: query, placeholder: "Search", font: body, width: 352, height: 36, bg: 0x20202C]
        Text("{saved} saved") #[font: body, color: 0x938F99, size: 14, width: 352]
    }
}
