// RFC-0057: motion on colours and gradients. Tap the chip (or run
// `byard shot . --tap 60,40 --at 120`) and everything below changes at once:
// the chip's fill, outline and label, the translucent state layer over it, a
// gradient, a shadow colour and a canvas fill. Each moves with its own curve.
View Main() {
    var on = false

    Column #[bg: 0x141218, p: 24, gap: 24, width: 440, height: 560] {
        Text("Tap the chip") #[color: 0xCAC4D0]

        // A filter chip: container colour, outline and label animate; the
        // state layer on top is a translucent overlay fading in from clear.
        ZStack #[
            width: 168,
            height: 48,
            radius: 12,
            origin: center,
            bg: on ? 0xFF4A4458 : 0x00000000 with anim.spring(),
            border: on ? 0x00938F99 : 0xFF938F99 with anim.easeInOut(300ms),
            border_width: 1,
            tap => on = !on,
        ] {
            Box #[
                width: 168,
                height: 48,
                radius: 12,
                bg: on ? 0x1FE8DEF8 : 0x00E8DEF8 with anim.easeInOut(300ms),
            ] {}
            Column #[width: 168, height: 48, align: center, justify: center] {
                Text("Selected") #[color: on ? 0xFFE8DEF8 : 0xFFCAC4D0 with anim.easeInOut(300ms)]
            }
        }

        // The same transparent-to-colour fade, drawn over a light surface:
        // no grey fringe, the lilac is the lilac the whole way.
        Box #[width: 168, height: 48, radius: 12, bg: 0xFFFFFBFE] {
            Box #[
                width: 168,
                height: 48,
                radius: 12,
                bg: on ? 0xFF6750A4 : 0x00000000 with anim.linear(300ms),
            ] {}
        }

        // A whole gradient, stop by stop.
        Box #[
            width: 168,
            height: 48,
            radius: 24,
            bg: 0xFF000000,
            gradient: on ? (angle: 90deg, from: 0xFFEF5350, to: 0xFFFFCA28) : (angle: 90deg, from: 0xFF3B82F6, to: 0xFF22D3EE) with anim.easeInOut(300ms),
        ] {}

        // A shadow's colour and a canvas shape's fill.
        Box #[
            width: 168,
            height: 48,
            radius: 12,
            bg: 0xFF2B2930,
            shadow: (y: 6, blur: 16, color: on ? 0xFFEF5350 : 0xFF3B82F6 with anim.easeInOut(300ms)),
        ] {}
        Canvas #[width: 168, height: 48] {
            circle(cx: 24, cy: 24, r: 18,
                fill: on ? 0xFFEF5350 : 0xFF3B82F6 with anim.easeInOut(300ms))
        }
    }
}
