// Composing components (RFC-0062): a list item with a leading and a trailing slot, a callback that
// makes it clickable only when it was given, a layout attribute on a view call, and a field whose
// label and indicator follow the field's focus without a `var`.
//
// Run these from the repo root. No window is opened.
//
//   1. At rest: three list items (the first two with a leading icon, the first with a switch, the
//      third with neither), and the empty field with its label down:
//        cargo run -p byard-cli -- shot crates/byard-cli/examples/composing_components -o rest.png
//   2. Tab three times focuses the field (the stops before it are the switch and the clickable
//      "About" item): the label floats
//      up and turns purple, and the indicator turns purple, though neither is the field:
//        cargo run -p byard-cli -- shot crates/byard-cli/examples/composing_components \
//            --key Tab --key Tab --key Tab -o focus.png
//   3. The same, typing a name; the label stays up:
//        cargo run -p byard-cli -- shot crates/byard-cli/examples/composing_components \
//            --key Tab --key Tab --key Tab --type Ada -o typed.png
//   4. A tap on the switch (the trailing slot of the first item) turns Wi-Fi off:
//        cargo run -p byard-cli -- shot crates/byard-cli/examples/composing_components \
//            --tap 378,88 -o off.png
//   5. The pointer over the clickable item draws its hover; the others have none:
//        cargo run -p byard-cli -- shot crates/byard-cli/examples/composing_components \
//            --hover 100,200 -o hover.png
//
// `tests/it/composing_components_example.rs` runs the example and checks it.

// A list item: one headline, and a leading and a trailing slot that may each be left out. It is
// a button exactly when it was given `on_tap`; the two roots are why a slot has to work in both
// branches of a `when`.
View ListItem(
    headline: Str,
    leading: Slot = none,
    trailing: Slot = none,
    on_tap: Fn() = none
) {
    when on_tap != none {
        Row #[
            height: 56,
            p: (0, 16),
            gap: 16,
            align: center,
            bg: 0xFEF7FF,
            width: 420,
            a11y_role: button,
            a11y_label: headline,
            tap => on_tap(),
        ] {
            on hover { overlay: 0x146750A4 }
            on focus_visible { outline: 0x6750A4, outline_width: 2 }
            when leading != none { leading }
            Text(headline) #[size: 16, color: 0x1D1B20, grow: 1]
            when trailing != none { trailing }
        }
    } else {
        Row #[height: 56, p: (0, 16), gap: 16, align: center, bg: 0xFEF7FF, width: 420] {
            when leading != none { leading }
            Text(headline) #[size: 16, color: 0x1D1B20, grow: 1]
            when trailing != none { trailing }
        }
    }
}

// A round icon stand-in. Its margin is not its own: the caller gives it on the call.
View Dot(colour: Int) {
    Box #[width: 24, height: 24, radius: 12, bg: colour] {}
}

// A text field with a floating label and an indicator. Both are siblings of the field, and both
// read its focus by its name, `as field` and `on field.focused`. The label is written before the
// field, which is fine: a name belongs to the whole view.
View LabelledField(label: Str, bind value: Str) {
    ZStack #[width: 300, height: 64, alignment: top_start] {
        Text(label) #[color: 0x79747E, size: 16, ml: 16, mt: 18] {
            on field.focused { color: 0x6750A4, translate.y: -18, scale: 0.75 }
        }
        TextField #[
            bind: value,
            width: 300,
            height: 56,
            p: (28, 16, 6, 16),
            indicator: none,
            size: 16,
            color: 0x1D1B20,
        ] as field
        Box #[width: 300, height: 1, mt: 56, bg: 0x79747E] {
            on field.focused { bg: 0x6750A4 }
        }
    }
}

View Main() {
    var wifi = true
    var opened = 0
    var name = ""

    Column #[bg: 0xFEF7FF, p: (24, 0), gap: 8, width: 420, grow: 1] {
        Text("Settings") #[size: 24, color: 0x1D1B20, ml: 16]
        Column {
            ListItem("Wi-Fi", leading: { Dot(colour: 0x6750A4) #[ml: 0] }, trailing: { Toggle #[
                bind: wifi,
            ] })
            ListItem("Bluetooth", leading: { Dot(colour: 0x7D5260) })
            ListItem("About", on_tap: { opened += 1 }, trailing: { Text("{opened}") #[
                color: 0x49454F,
            ] })
        }
        LabelledField(label: "Name", bind: name) #[ml: 16, mt: 16]
    }
}
