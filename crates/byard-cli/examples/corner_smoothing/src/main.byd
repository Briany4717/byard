// RFC-0031 §S1–S3, superelliptical (continuous-curvature) corners.
//
// Run it (from the repo root):
//   cd crates/byard-cli/examples/corner_smoothing
//   cargo run -p byard-cli -- dev
//
// `smooth` is the corner *profile* `radius` is measured with. `0` is the
// circular arc every box drew before this property existed and is still the
// default, so nothing you already wrote changes. `0.6` is roughly the Apple
// continuous-corner profile; `1.0` is a pronounced squircle.
//
// What to look for, top to bottom:
//   1. The ramp: same `radius: 28`, seven profiles. The circle's corner meets
//      its straight edge at a curvature discontinuity you can see once you know
//      to look; the squircle's does not.
//   2. The shadow and the border follow the *same* profile as the fill, a
//      shadow with a different corner than its caster reads as a bug (§Q2).
//   3. Tap the card: `smooth` animates. It is a paint property, so the spring
//      runs entirely in the shader's exponent, nothing relaid out (INV-8).
//   4. The `Canvas` row: the `rect` shape kind takes the same scalar.
View Main() {
    var squircled = false

    Column #[bg: 0x14161C, p: 32, gap: 28, width: 760] {
        Text("smooth, the corner profile radius is measured with")
            #[color: 0xF2F3F5, size: 20, weight: bold]

        // ── 1. The ramp ──────────────────────────────────────────────────
        Text("radius: 28, smooth 0 → 1") #[color: 0x8A90A0, size: 13]
        Row #[gap: 12] {
            Box #[bg: 0x5B8DEF, radius: 28, smooth: 0.0, width: 92, height: 92] {}
            Box #[bg: 0x5B8DEF, radius: 28, smooth: 0.2, width: 92, height: 92] {}
            Box #[bg: 0x5B8DEF, radius: 28, smooth: 0.4, width: 92, height: 92] {}
            Box #[bg: 0x5B8DEF, radius: 28, smooth: 0.6, width: 92, height: 92] {}
            Box #[bg: 0x5B8DEF, radius: 28, smooth: 0.8, width: 92, height: 92] {}
            Box #[bg: 0x5B8DEF, radius: 28, smooth: 1.0, width: 92, height: 92] {}
        }

        // ── 2. Shadow and border take the same profile (§Q2) ─────────────
        Text("the shadow and the border share the caster's profile")
            #[color: 0x8A90A0, size: 13]
        Row #[gap: 20] {
            Box #[bg: 0xFFFFFF, radius: 32, smooth: 0.0, width: 140, height: 100,
                  shadow: (y: 10, blur: 24, color: 0x66000000)] {}
            Box #[bg: 0xFFFFFF, radius: 32, smooth: 1.0, width: 140, height: 100,
                  shadow: (y: 10, blur: 24, color: 0x66000000)] {}
            Box #[bg: 0x00000000, radius: 32, smooth: 1.0, width: 140, height: 100,
                  border: 0x5B8DEF, border_width: 3] {}
        }

        // ── 3. It animates (paint-class, RFC-0010) ───────────────────────
        Text("tap the card, smooth is animatable, and moves no layout")
            #[color: 0x8A90A0, size: 13]
        Box #[bg: 0xE8734A, radius: 44, width: 220, height: 120,
              smooth: squircled ? 1.0 : 0.0 with anim.spring(stiffness: 180, damping: 0.7)]
            => squircled = !squircled

        // ── 4. The Canvas `rect` kind takes the same scalar (§S3) ────────
        Text("Canvas rect(…, smooth:)") #[color: 0x8A90A0, size: 13]
        Canvas #[width: 320, height: 110, bg: 0x1C1F27] {
            rect(x: 16, y: 15, w: 80, h: 80, radius: 34, smooth: 0.0, fill: 0x4CC38A)
            rect(x: 120, y: 15, w: 80, h: 80, radius: 34, smooth: 0.6, fill: 0x4CC38A)
            rect(x: 224, y: 15, w: 80, h: 80, radius: 34, smooth: 1.0, fill: 0x4CC38A)
        }
    }
}
