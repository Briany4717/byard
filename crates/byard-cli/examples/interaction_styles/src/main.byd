// A Material-like button written with no `var` and no handler for its states (RFC-0059).
//
// `on hover`, `on pressed` and `on focus_visible` are written inside the element. The state
// layer is `overlay`, a colour drawn over the fill and under the label; the focus ring is
// `outline`, drawn outside the shape and taking no room; the pressed corners are `radius`,
// and they spring back on release because the state's `with` is also the way back. The role
// is a value, so one root is a toggle button or a plain one.
//
// Run these from the repo root. No window is opened.
//
//   1. At rest, with the three buttons, a toggle and a disabled one:
//        cargo run -p byard-cli -- shot crates/byard-cli/examples/interaction_styles -o rest.png
//   2. The pointer over Save draws the 8 % layer (hover):
//        cargo run -p byard-cli -- shot crates/byard-cli/examples/interaction_styles \
//            --hover 80,100 -o hover.png
//   3. A held press on Save: the 10 % layer and the tighter corners, mid-spring:
//        cargo run -p byard-cli -- shot crates/byard-cli/examples/interaction_styles \
//            --hold 80,100 --at 120 -o hold.png
//   4. Tab draws the ring, 3 px thick and 2 px outside the button, and a tap does not:
//        cargo run -p byard-cli -- shot crates/byard-cli/examples/interaction_styles \
//            --key Tab -o tab.png
//   5. Tab, Tab, Space presses the toggle, which a reader then calls a toggle button that is on:
//        cargo run -p byard-cli -- shot crates/byard-cli/examples/interaction_styles \
//            --key Tab --key Tab --key Space --a11y tree.txt -o toggled.png
//   6. The disabled button takes no hover, no press and no Tab stop; the dump says
//      `[focusable disabled]` for it.
//
// `tests/it/interaction_styles_example.rs` runs the dump and checks it.
View Main() {
    inject Theme as t
    var taps = 0
    var starred = false

    Column #[bg: t.surface, p: 32, gap: 28, width: 480, grow: 1] {
        Text("Taps: {taps}") #[color: t.onSurface, size: 16]

        Row #[gap: 24, align: center] {
            Pill(label: "Save", on_tap: { taps += 1 })
            Pill(label: "Star", toggle: true, selected: starred, on_tap: { starred = !starred })
            Pill(label: "Off", disabled: true)
        }
    }
}

// The control. It reads its own states from the engine: no `var`, no `pointer_enter`, no
// `focus =>`, no view wrapped around it for the tint or the ring.
View Pill(label: Str, toggle: Bool = false, selected: Bool = false, disabled: Bool = false,
    on_tap: Fn() = {}) {
    inject Theme as t

    let on = toggle && selected
    let fill = disabled ? t.onSurface.alpha(0.12) : on ? t.secondary : t.primary
    let ink = disabled ? t.onSurface.alpha(0.38) : on ? t.onSecondary : t.onPrimary

    Box #[
        bg: fill with t.springEffectsFast,
        radius: (on ? 12 : 20) with t.springSpatialFast,
        width: 112,
        height: 40,
        align: center,
        justify: center,
        a11y_role: toggle ? toggle_button : button,
        a11y_checked: on,
        disabled: disabled,
        tap => on_tap(),
    ] {
        on hover { overlay: ink.alpha(0.08) with t.springEffectsFast }
        on pressed { overlay: ink.alpha(0.10), radius: 8 with t.springSpatialFast }
        on focus_visible { outline: t.secondary, outline_width: 3, outline_offset: 2 }
        on disabled { overlay: 0x00000000 }

        Text(label) #[typo: t.labelLarge, color: ink with t.springEffectsFast, wrap: false]
    }
}
