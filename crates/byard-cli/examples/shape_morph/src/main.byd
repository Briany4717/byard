// RFC-0031 §S9–§S10, `ngon` and sequence morphing.
//
// Run it (from the repo root):
//   cd crates/byard-cli/examples/shape_morph
//   cargo run -p byard-cli -- dev
//
// `ngon(n, r, corner, inner, rotate)` is one parametric shape kind that covers
// the n-fold symmetric half of the Material 3 Expressive vocabulary: `inner: 1`
// is a convex polygon, lower values pull the notches in towards the centre to
// give scallops and bursts, and `corner` rounds every point and every notch.
//
// `morph: <scalar>` reinterprets a Canvas's shapes as a *sequence*. The scalar
// indexes it, `floor(phase)` and `floor(phase) + 1` blended by `fract(phase)`
//, and it wraps, so a value sweeping 0 → N returns to the first shape with no
// discontinuity. Because it is an ordinary animatable scalar, every RFC-0010 /
// RFC-0025 modifier applies with no new surface.
//
// What to look for:
//   1. The vocabulary row: one kind, five shapes, no asset pipeline.
//   2. The loader: seven shapes, 650 ms each, one linear infinite curve. This
//      is Material 3 Expressive's morphing loading indicator, reproduced with
//      machinery that already shipped.
//   3. Tap the card: a spring between two shapes, the interaction-state case.
//      Two members and a phase in [0, 1] is the same code path as the loader.
//   4. Circle → 7-point star: the fields are interpolated, not the vertices, so
//      a morph between two *different kinds* is continuous.
View Main() {
    var selected = false

    Column #[bg: 0x14161C, p: 32, gap: 26, width: 720] {
        Text("ngon + morph, one shape kind and one animated scalar")
            #[color: 0xF2F3F5, size: 20, weight: bold]

        // ── 1. The vocabulary ────────────────────────────────────────────
        Text("one kind: polygon, squircle, scallop, burst, star")
            #[color: 0x8A90A0, size: 13]
        Canvas #[width: 620, height: 130, bg: 0x1C1F27] {
            ngon(cx: 65,  cy: 65, r: 46, n: 6, corner: 6,            fill: 0x5B8DEF)
            ngon(cx: 190, cy: 65, r: 46, n: 4, corner: 26,           fill: 0x5B8DEF)
            ngon(cx: 315, cy: 65, r: 46, n: 8, corner: 5, inner: 0.82, fill: 0x4CC38A)
            ngon(cx: 440, cy: 65, r: 46, n: 5, corner: 4, inner: 0.42, fill: 0xE8B54A)
            ngon(cx: 555, cy: 65, r: 46, n: 7, corner: 3, inner: 0.55, rotate: 12deg,
                 fill: 0xE8734A)
        }

        // ── 2. The Material 3 Expressive loading indicator ───────────────
        Text("the loader: 7 members, anim.linear(4550ms, repeat: infinite)")
            #[color: 0x8A90A0, size: 13]
        Row #[gap: 24] {
            // The loader: 7 shapes × 650 ms = 4550 ms per revolution, from one
            // animated scalar on the `morph:` attribute.
            Canvas #[width: 120, height: 120, bg: 0x1C1F27,
                     morph: 7.0 with anim.linear(4550ms, from: 0.0, repeat: infinite)] {
                ngon(cx: 60, cy: 60, r: 44, n: 4, corner: 10,             fill: 0x5B8DEF)
                ngon(cx: 60, cy: 60, r: 44, n: 6, corner: 7,  inner: 0.9, fill: 0x5B8DEF)
                ngon(cx: 60, cy: 60, r: 44, n: 8, corner: 5,  inner: 0.8, fill: 0x5B8DEF)
                ngon(cx: 60, cy: 60, r: 44, n: 5, corner: 4,  inner: 0.6, fill: 0x5B8DEF)
                ngon(cx: 60, cy: 60, r: 44, n: 7, corner: 3,  inner: 0.7, fill: 0x5B8DEF)
                ngon(cx: 60, cy: 60, r: 44, n: 3, corner: 12,             fill: 0x5B8DEF)
                ngon(cx: 60, cy: 60, r: 44, n: 12, corner: 3, inner: 0.9, fill: 0x5B8DEF)
            }

            // ── 4. Two different kinds, and a colour that rides the same
            //       scalar, one animation rather than two that can drift.
            Canvas #[width: 120, height: 120, bg: 0x1C1F27,
                     morph: 2.0 with anim.linear(1300ms, from: 0.0, repeat: infinite)] {
                circle(cx: 60, cy: 60, r: 44, fill: 0x4CC38A)
                ngon(cx: 60, cy: 60, r: 44, n: 7, corner: 3, inner: 0.5, fill: 0xE8734A)
            }
        }

        // ── 3. The interaction-state case ────────────────────────────────
        Text("tap the square, the same code path, two members and a spring")
            #[color: 0x8A90A0, size: 13]
        Canvas #[width: 120, height: 120, bg: 0x1C1F27,
                 morph: selected ? 1.0 : 0.0
                     with anim.spring(stiffness: 200, damping: 0.6),
                 tap => selected = !selected] {
            ngon(cx: 60, cy: 60, r: 44, n: 4, corner: 8, fill: 0xE8B54A)
            circle(cx: 60, cy: 60, r: 44, fill: 0xE8B54A)
        }
    }
}
