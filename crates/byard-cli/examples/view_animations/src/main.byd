// RFC-0010, a view with motion used more than once on one screen.
//
// Draw it (from the repo root, no window):
//   cargo run -p byard-cli -- shot crates/byard-cli/examples/view_animations --size 360x220 -o view_animations.png
//   cargo run -p byard-cli -- shot crates/byard-cli/examples/view_animations --size 360x220 --tap 40,175 -o flipped.png
//
// A view is written once, so every call of it shares the source position of
// each `with` inside it. Animation state belongs to the *instance*, the same
// identity a view's `var`s have, so each call animates on its own.
//
// What to verify:
//   1. The three boxes in the top row are drawn with three different corner
//      radii: a pill, nearly square, a pill. Not three of the last call's
//      radius: it was once the case that the middle one came out a pill too.
//   2. The same holds when the calls are in different places: the row below
//      holds one inside a `Row`, one behind a `when` and one passed through
//      another view (`Framed`). Each has its own colour and its own radius.
//   3. The second picture taps "Flip": all six change target at once and each
//      has moved to its own, the first box square and the second a pill.
//   4. Run it with `dev`, press "Flip" and watch them spring, and press "Hide /
//      show": the box behind the `when` comes back from the start, the others
//      do not move.
View Main() {
    var flipped = false
    var shown = true

    Column #[bg: 0x0E1116, p: 20, gap: 14, grow: 1] {
        Row #[gap: 12] {
            Chip(r: flipped ? 2 : 28, tint: 0x3355CC, label: "top left")
            Chip(r: flipped ? 28 : 2, tint: 0x33AA77, label: "top middle")
            Chip(r: flipped ? 14 : 28, tint: 0xCC5533, label: "top right")
        }
        Row #[gap: 12] {
            Chip(r: flipped ? 28 : 14, tint: 0x8855CC, label: "inside a Row")
            when shown {
                Chip(r: flipped ? 14 : 28, tint: 0xCC9933, label: "behind a when")
            }
            Framed(r: flipped ? 28 : 2, tint: 0x33AACC)
        }
        Row #[gap: 12] {
            Button("Flip") #[bg: 0x2A2F3A, color: 0xFFFFFF, p: 10] => flipped = !flipped
            Button("Hide / show") #[bg: 0x2A2F3A, color: 0xFFFFFF, p: 10] => shown = !shown
        }
    }
}

View Framed(r: Int, tint: Int) {
    Chip(r: r, tint: tint, label: "behind another view")
}

View Chip(r: Int, tint: Int, label: Str) {
    Box #[
        bg: tint with anim.spring(),
        radius: r with anim.spring(),
        width: 80,
        height: 50,
        a11y_label: "{label}",
    ] {}
}
