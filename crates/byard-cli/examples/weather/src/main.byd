// RFC-0029, HTTP and JSON: a real weather app, with no `.rs` at all.
//
// Run it (from the repo root):
//   cd crates/byard-cli/examples/weather
//   cargo run -p byard-cli -- dev
//
// It fetches live data from open-meteo.com, which needs no API key, so this
// runs as written. Pick a city and the panel repaints when the answer lands.
//
// Nothing here is application code in disguise: `Http` and `Json` are ordinary
// controllers the engine provides (RFC-0029 §7), reached through the same
// `inject` any app controller uses, and answering through the same `ok`/`err`
// arms. The whole app is the three states a request has, and a JSON response
// that reads like a record because it *is* one (RFC-0027 §6).
View Main() {
    inject Http as http

    // "idle" · "loading" · "ok" · "error"
    var state: Str = "idle"
    var city: Str = "Tokyo"
    var temp: Float = 0.0
    var wind: Float = 0.0
    var day_high: Float = 0.0
    var day_low: Float = 0.0
    var message: Str = ""
    // The selected place, so the refresh timer knows what to re-ask for.
    var lat: Float = 35.68
    var lon: Float = 139.69
    var refreshes: Int = 0

    // Latitude/longitude per city, so the example needs no geocoding round
    // trip and stays about the one thing it is demonstrating.
    let places = [
        { name: "Tokyo",     lat: 35.68,  lon: 139.69 },
        { name: "Reykjavik", lat: 64.15,  lon: -21.94 },
        { name: "Nairobi",   lat: -1.29,  lon: 36.82 },
        { name: "Santiago",  lat: -33.45, lon: -70.67 }
    ]

    // RFC-0029 §5: a forecast goes stale, so it is re-asked for on a timer as
    // well as on a press. `every 30s` is short for an example; a real app says
    // `every 5min`, which is the unit the lexer learned for exactly this
    // sentence. The timer is scoped to this view, so closing the window stops
    // the polling rather than leaving it running (INV-10).
    every 30s => {
        refreshes = refreshes + 1
        http.get("https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&current=temperature_2m,wind_speed_10m&daily=temperature_2m_max,temperature_2m_min&forecast_days=1")
            ok res => {
                state = "ok"
                temp = res.json.current.temperature_2m
                wind = res.json.current.wind_speed_10m
                day_high = res.json.daily.temperature_2m_max[0]
                day_low = res.json.daily.temperature_2m_min[0]
            }
            err e => {
                state = "error"
                message = e.message
            }
    }

    Column #[bg: 0x14141C, p: 32, gap: 20, width: 720] {
        Text("RFC-0029, weather over HTTP") #[color: 0xFFFFFF, size: 26, weight: bold]
        Text("open-meteo.com · no API key · no Rust in this app")
            #[color: 0x9AA0AC, size: 13]

        Row #[gap: 10] {
            for place in places {
                // Each button is one request. The action sets the loading
                // state and returns; the arms run when the answer arrives.
                Button(place.name)
                    #[bg: 0x262636, radius: 10, color: 0xFFFFFF,
                      p: (vertical: 10, horizontal: 16)]
                    => {
                        state = "loading"
                        city = place.name
                        lat = place.lat
                        lon = place.lon
                        message = ""
                        http.get("https://api.open-meteo.com/v1/forecast?latitude={place.lat}&longitude={place.lon}&current=temperature_2m,wind_speed_10m&daily=temperature_2m_max,temperature_2m_min&forecast_days=1")
                            ok res => {
                                state = "ok"
                                temp = res.json.current.temperature_2m
                                wind = res.json.current.wind_speed_10m
                                day_high = res.json.daily.temperature_2m_max[0]
                                day_low = res.json.daily.temperature_2m_min[0]
                            }
                            err e => {
                                state = "error"
                                message = e.message
                            }
                    }
            }
        }

        when state == "loading" {
            Row #[bg: 0x1E1E2A, radius: 14, p: 24, gap: 14, align: center] {
                // A plain spinner: the request is in flight and the window is
                // not blocked, which is the thing worth seeing.
                Canvas #[width: 22, height: 22] {
                    arc(cx: 11, cy: 11, r: 9, start: 0deg,
                        sweep: 300deg with anim.linear(900ms, repeat: infinite),
                        stroke: 0x477A96, stroke_width: 3)
                }
                Text("asking about {city}…") #[color: 0x9AA0AC, size: 16]
            }
        }

        when state == "ok" {
            Column #[bg: 0x1E1E2A, radius: 14, p: 24, gap: 10] {
                Text("{city}") #[color: 0x9AA0AC, size: 14, weight: bold]
                Text("{temp}°C") #[color: 0xFFFFFF, size: 44, weight: bold]
                Row #[gap: 20] {
                    Text("high {day_high}°") #[color: 0x9AA0AC, size: 14]
                    Text("low {day_low}°") #[color: 0x9AA0AC, size: 14]
                    Text("wind {wind} km/h") #[color: 0x9AA0AC, size: 14]
                }
                Text("auto-refreshed {refreshes} times") #[color: 0x6A7080, size: 12]
            }
        }

        // Turn the wifi off and press a city: the `err` arm runs, and the
        // failure is named rather than being a spinner that never stops.
        when state == "error" {
            Column #[bg: 0x2A1E1E, radius: 14, p: 24, gap: 8, border: 0x964747] {
                Text("could not reach the forecast") #[color: 0xFFFFFF, size: 18]
                Text("{message}") #[color: 0xC08080, size: 13]
            }
        }
    }
}
