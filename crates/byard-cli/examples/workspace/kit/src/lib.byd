// A package view with a parameter (RFC-0007), consumed as `kit.Card` / `k.Card`.
View Card(label: Str) {
    Box #[bg: 0x262636, radius: 12, p: 14, border: 0x3C3C52] {
        Column #[gap: 4] {
            Text(label) #[color: 0xE6E1E5, size: 15]
            Caption("a private view of the kit")
        }
    }
}

// Private (RFC-0055): `Card` uses it, and an app that writes `k.Caption(...)`
// is told it is private to `kit`.
private View Caption(text: Str) {
    Text(text) #[color: 0x9AA0AC, size: 11]
}
