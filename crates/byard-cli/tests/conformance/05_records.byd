// Records and record types: fields, spread, optional fields, equality.

//# covers: records, record-types, tuples

//# case: literal-and-field
//# fragment
//# text: Ada 3
let u = { name: "Ada", score: 3 }
Text("{u.name} {u.score}")

//# case: spread-then-override
//# fragment
//# text: Ada 10 true
let u = { name: "Ada", score: 3 }
let v = { ..u, score: 10, on: true }
Text("{v.name} {v.score} {v.on}")

//# case: spread-does-not-change-the-source
//# fragment
//# text: 3
//# warning: UnusedVariable
let u = { name: "Ada", score: 3 }
let v = { ..u, score: 10 }
Text("{u.score}")

//# case: nested-records
//# fragment
//# text: 1
let u = { a: { b: { c: 1 } } }
Text("{u.a.b.c}")

//# case: missing-field-on-a-literal-is-an-error-unless-it-has-a-default
//# fragment
//# error: UnknownField
//# diagnostics: 1
let u = { name: "Ada" }
Text("[{u.email}] {u.email ?? "none"}")

//# case: missing-field-on-a-literal-is-an-error
//# fragment
//# error: UnknownField
let u = { name: "Ada" }
Text("{u.nmae}")

//# case: field-of-a-field-the-literal-lacks-is-an-error
//# fragment
//# error: UnknownField
//# diagnostics: 1
let u = { a: 1 }
Text("[{u.x.y.z}]")

//# case: field-of-nothing-with-a-default-is-nothing
//# fragment
//# text: 0
let u = { a: 1 }
Text("{u.x.y.z ?? 0}")

//# case: declared-type-checks-fields
//# error: UnknownField
type Place = { name: Str, country: Str? }
View Main() {
    var places: List<Place> = []
    for hit in places { Text(hit.nmae) }
}

//# case: declared-type-optional-field
//# text: at sea NO
type Place = { name: Str, country: Str? }
View Main() {
    var places: List<Place> = [{ name: "Mid" }, { name: "Oslo", country: "NO" }]
    Text("{places[0].country ?? "at sea"} {places[1].country ?? "at sea"}")
}

//# case: declared-type-literal-with-a-wrong-field-type
//# error: TypeMismatch
type P = { name: Str, age: Int }
View Main() {
    var p: P = { name: 1, age: "x" }
    Text(p.name)
}

//# case: declared-type-literal-with-an-extra-field
//# error: UnknownField
type P = { name: Str }
View Main() {
    var p: P = { name: "a", extra: true }
    Text(p.name)
}

//# case: declared-type-literal-missing-a-required-field
//# error: TypeMismatch
type P = { name: Str, age: Int }
View Main() {
    var p: P = { name: "a" }
    Text(p.name)
}

//# case: duplicate-record-type
//# error: DuplicateRecordType
type P = { a: Int }
type P = { b: Int }
View Main() { Text("x") }

//# case: record-type-with-unknown-field-type
//# error: UnknownType
type P = { a: Nope }
View Main() { Text("x") }

//# case: equality-is-structural
//# fragment
//# text: true false
Text("{ { a: 1, b: 2 } == { a: 1, b: 2 } } { { a: 1 } == { a: 2 } }")

//# case: equality-ignores-field-order
//# fragment
//# text: true
Text("{ { a: 1, b: 2 } == { b: 2, a: 1 } }")

//# case: duplicate-field-in-a-literal
//# fragment
//# error: DuplicateField
let u = { a: 1, a: 2 }
Text("{u.a}")

//# case: field-write-rebuilds-the-record
//# fragment
//# text: 10
var u = { name: "Ada", score: 3 }
on mount => { u = { ..u, score: 10 } }
Text("{u.score}")

//# case: field-assignment
//# fragment
//# text: 10
var u = { name: "Ada", score: 3 }
on mount => { u.score = 10 }
Text("{u.score}")

//# case: nested-field-assignment
//# fragment
//# text: 2
var u = { a: { b: 1 } }
on mount => { u.a.b = 2 }
Text("{u.a.b}")

//# case: field-assignment-keeps-the-other-fields
//# fragment
//# text: Ada 10
var u = { name: "Ada", score: 3 }
on mount => { u.score = 10 }
Text("{u.name} {u.score}")

//# case: field-compound-assignment
//# fragment
//# text: 5 | 2
var u = { score: 3, lives: 3 }
on mount => { u.score += 2 u.lives-- }
Text("{u.score}")
Text("{u.lives}")

//# case: field-increment
//# fragment
//# text: 4
var u = { score: 3 }
on mount => { u.score++ }
Text("{u.score}")

//# case: nested-field-assignment-keeps-its-siblings
//# fragment
//# text: 2 7
var u = { a: { b: 1, c: 7 } }
on mount => { u.a.b = 2 }
Text("{u.a.b} {u.a.c}")

//# case: field-assignment-of-a-field-that-is-not-there
//# fragment
//# error: TypeMismatch
//# diagnostics: 1
var u = { name: "Ada" }
on mount => { u.score = 10 }
Text("{u.name}")

//# case: field-assignment-of-the-wrong-type
//# fragment
//# error: TypeMismatch
//# diagnostics: 1
var u = { score: 3 }
on mount => { u.score = "ten" }
Text("{u.score}")

//# case: field-assignment-to-a-let
//# fragment
//# error: NotAssignable
//# diagnostics: 1
let u = { score: 3 }
on mount => { u.score = 10 }
Text("{u.score}")

//# case: field-assignment-reaches-a-declared-record
//# text: 7
type Player = { name: Str, score: Int }
View Main() {
    var p: Player = { name: "Ada", score: 1 }
    on mount => { p.score = 7 }
    Text("{p.score}")
}

//# case: index-assignment
//# fragment
//# text: 9
var xs = [1, 2]
on mount => { xs[0] = 9 }
Text("{xs[0]}")

//# case: tuple-named-and-positional
//# fragment
//# text: ok
Box #[p: (8, 16), m: (top: 4, horizontal: 8)] { Text("ok") }

//# case: record-of-lists
//# fragment
//# text: 2 b
let r = { xs: [1, 2], names: ["a", "b"] }
Text("{r.xs.len} {r.names[1]}")

//# case: empty-braces-are-an-action-not-a-record
//# fragment
//# text: ok
//# warning: UnusedVariable
let nothing = {}
Text("ok")

//# case: spread-keeps-the-fields-of-what-it-spreads
//# fragment
//# text: Ada 2
let a = { name: "Ada", score: 1 }
let b = { ..a, score: 2 }
Text("{b.name} {b.score}")

//# case: spread-record-misspelt-field
//# fragment
//# error: UnknownField
//# diagnostics: 1
let a = { name: "Ada", score: 1 }
let b = { ..a, score: 2 }
Text("{b.nmae}")

//# case: declared-type-literal-may-leave-an-optional-field-out
//# text: a
type P = { name: Str, note: Str? }
View Main() {
    var p: P = { name: "a" }
    Text(p.name)
}

//# case: declared-type-literal-with-a-spread-needs-no-other-fields
//# text: b
type P = { name: Str, age: Int }
View Main() {
    var p: P = { name: "a", age: 1 }
    on mount => { p = { ..p, name: "b" } }
    Text(p.name)
}

//# case: declared-type-list-item-of-the-wrong-type
//# error: TypeMismatch
//# diagnostics: 1
type P = { name: Str }
View Main() {
    var ps: List<P> = [{ name: "a" }, { name: 2 }]
    Text("{ps.len}")
}

//# case: literal-assigned-another-set-of-fields-is-an-error
//# fragment
//# error: TypeMismatch
//# diagnostics: 1
var u = { name: "a" }
on mount => { u = { name: "a", extra: 1 } }
Text(u.name)

//# case: records-with-other-fields-are-not-equal
//# fragment
//# text: false false
Text("{ { a: 1 } == { a: 2 } } { { a: 1, b: 2 } == { a: 1, c: 2 } }")

//# case: loop-variable-over-a-list-of-literals-has-its-fields
//# fragment
//# error: UnknownField
//# diagnostics: 1
let ps = [{ name: "a" }, { name: "b" }]
for p in ps {
    Text(p.nmae)
}

//# case: lambda-over-a-list-of-literals-reads-its-fields
//# fragment
//# text: a,b
let ps = [{ name: "a" }, { name: "b" }]
Text("{ps.map(p => p.name).join(",")}")

//# case: a-type-with-a-parameter-gives-its-fields-the-type-of-each-use
//# text: 2 a | a=2 | b=3
type Item = { name: Str, qty: Int }
type Page<T> = { items: List<T>, total: Int }
View Main() {
    var page: Page<Item> = { items: [{ name: "a", qty: 2 }, { name: "b", qty: 3 }], total: 2 }
    Text("{page.items.len} {page.items[0].name}")
    for item in page.items { Text("{item.name}={item.qty}") }
}

//# case: a-type-with-two-parameters
//# text: x 1
type Pair<A, B> = { first: A, second: B }
View Main() {
    let pair: Pair<Str, Int> = { first: "x", second: 1 }
    Text("{pair.first} {pair.second}")
}

//# case: a-field-of-the-type-given-is-checked
//# error: TypeMismatch
//# diagnostics: 1
type Box<T> = { value: T }
View Main() {
    let b: Box<Int> = { value: "a" }
    Text("{b.value}")
}

//# case: a-field-a-type-with-a-parameter-does-not-have
//# error: UnknownField
//# diagnostics: 1
type Page<T> = { items: List<T> }
View Main() {
    let p: Page<Int> = { items: [1] }
    Text("{p.itms.len}")
}

//# case: a-type-that-uses-itself-in-its-fields
//# text: 2
type Tree<T> = { value: T, kids: List<Tree<T>> }
View Main() {
    let t: Tree<Int> = { value: 1, kids: [{ value: 2, kids: [] }] }
    Text("{t.kids[0].value}")
}

//# case: a-function-takes-a-type-with-a-parameter
//# text: 2
type Page<T> = { items: List<T> }
fn size(p: Page<Int>) -> Int => p.items.len
View Main() {
    let p: Page<Int> = { items: [4, 5] }
    Text("{size(p)}")
}

//# case: a-type-with-a-parameter-used-without-one
//# error: TypeArgumentCount
//# diagnostics: 1
type Page<T> = { items: List<T> }
View Main() {
    let p: Page = { items: [1] }
    Text("{p.items.len}")
}

//# case: a-type-with-a-parameter-given-two
//# error: TypeArgumentCount
//# diagnostics: 1
type Page<T> = { items: List<T> }
View Main() {
    let p: Page<Int, Str> = { items: [1] }
    Text("{p.items.len}")
}

//# case: a-type-without-parameters-given-one
//# error: TypeArgumentCount
//# diagnostics: 1
type Place = { n: Int }
View Main() {
    let p: Place<Int> = { n: 1 }
    Text("{p.n}")
}

//# case: a-field-of-a-type-with-a-parameter-names-no-type
//# error: UnknownType
//# diagnostics: 1
type Page<T> = { items: Lst<T> }
View Main() { Text("x") }

//# case: a-reply-may-be-cast-to-a-type-with-a-parameter
type Box<T> = { value: T }
View Main() {
    inject Json as json
    var n = 0
    on mount => {
        json.parse("\{\"value\": 3\}")
            ok v => { n = (v as Box<Int>).value }
    }
    Text("{n}")
}
