// `fn`, lambdas, named actions, and what is and is not checked about calls.

//# covers: shared-functions, functions-as-values, functions-in-a-view, actions

//# case: view-function
//# fragment
//# text: 72 is a B
var score = 72
fn grade(points: Int) -> Str => points >= 90 ? "A" : points >= 70 ? "B" : "C"
Text("{score} is a {grade(score)}")

//# case: view-function-reads-state
//# fragment
//# text: 10
var n = 5
fn doubled() -> Int => n * 2
Text("{doubled()}")

//# case: view-function-follows-state
//# fragment
//# text: 20
var n = 5
fn doubled() -> Int => n * 2
on mount => { n = 10 }
Text("{doubled()}")

//# case: function-calls-function
//# text: 12
fn twice(x: Int) -> Int => x * 2
fn thrice_twice(x: Int) -> Int => twice(x) * 3
View Main() { Text("{thrice_twice(2)}") }

//# case: function-argument-is-evaluated-once-per-use
//# fragment
//# text: 9
fn sq(x: Int) -> Int => x * x
Text("{sq(1 + 2)}")

//# case: function-parameter-shadows-a-var
//# fragment
//# text: 7 1
var x = 1
fn id(x: Int) -> Int => x
Text("{id(7)} {x}")

//# case: function-too-few-arguments
//# error: ArityMismatch
fn add(a: Int, b: Int) -> Int => a + b
View Main() { Text("{add(1)}") }

//# case: function-too-many-arguments
//# error: ArityMismatch
fn add(a: Int, b: Int) -> Int => a + b
View Main() { Text("{add(1, 2, 3)}") }

//# case: function-argument-of-the-wrong-type
//# error: ArgumentTypeMismatch
fn add(a: Int, b: Int) -> Int => a + b
View Main() { Text("{add(1, "x")}") }

//# case: function-body-of-the-wrong-type
//# error: TypeMismatch
fn name(a: Int) -> Str => a + 1
View Main() { Text(name(1)) }

//# case: function-named-arguments
//# text: 1
fn sub(a: Int, b: Int) -> Int => a - b
View Main() { Text("{sub(b: 1, a: 2)}") }

//# case: function-unknown
//# fragment
//# error: UnknownName
Text("{dobule(1)}")

//# case: function-int-where-float-is-wanted
//# text: 1.5
fn half(x: Float) -> Float => x / 2
View Main() { Text("{half(3)}") }

//# case: function-with-a-block-body
//# text: 6
fn area(w: Int, h: Int) -> Int => {
    let a = w * h
    a
}
View Main() { Text("{area(2, 3)}") }

//# case: generic-function
//# text: 1
fn first<T>(xs: List<T>) -> T => xs[0]
View Main() { Text("{first([1, 2])}") }

//# case: named-action
//# fragment
//# text: 11 2
var count = 0
var steps = 0
let add = (by: Int) => {
    count += by
    steps++
}
on mount => { add(1) add(10) }
Text("{count} {steps}")

//# case: named-action-without-parameters
//# fragment
//# text: 1
var n = 0
let bump = () => { n++ }
on mount => bump()
Text("{n}")

//# case: named-action-calls-another
//# fragment
//# text: 2
var n = 0
let one = () => { n++ }
let two = () => { one() one() }
on mount => two()
Text("{n}")

//# case: named-action-wrong-arity
//# fragment
//# error: ArityMismatch
var n = 0
let add = (by: Int) => { n += by }
on mount => add()
Text("{n}")

//# case: named-action-wrong-type
//# fragment
//# error: ArgumentTypeMismatch
var n = 0
let add = (by: Int) => { n += by }
on mount => add("x")
Text("{n}")

//# case: lambda-value-in-a-let
//# fragment
//# text: 6
let twice = (x: Int) => x * 2
Text("{twice(3)}")

//# case: lambda-two-forms-are-the-same
//# fragment
//# text: 2,4 2,4
let xs = [1, 2]
Text("{xs.map(x => x * 2).join(",")} {xs.map(|x| x * 2).join(",")}")

//# case: lambda-reads-outer-state
//# fragment
//# text: 11,12
var base = 10
Text("{[1, 2].map(x => x + base).join(",")}")

//# case: lambda-parameter-shadows
//# fragment
//# text: 1,2 9
let x = 9
Text("{[1, 2].map(x => x).join(",")} {x}")

//# case: lambda-field-typo-on-a-typed-list
//# error: UnknownField
type P = { name: Str }
View Main() {
    var ps: List<P> = []
    Text("{ps.map(p => p.nmae).len}")
}

//# case: lambda-field-typo-on-an-inferred-list
//# fragment
//# error: UnknownField
let ps = [{ name: "a" }]
Text("{ps.map(p => p.nmae).len}")

//# case: untrack
//# fragment
//# text: 1
var a = 1
let b = untrack(a)
Text("{b}")

//# case: untrack-does-not-follow-the-value
//# fragment
//# text: 1 | 1
var a = 1
let b = untrack(a)
let c = untrack(a + 0)
on mount => { a = 5 }
Text("{b}")
Text("{c}")

//# case: calling-a-number
//# fragment
//# error: TypeMismatch
let n = 5
Text("{n(1)}")

//# case: function-with-an-unknown-parameter-type
//# error: UnknownType
//# diagnostics: 1
fn double(n: Numbr) -> Int => 2
View Main() { Text("{double(1)}") }

//# case: function-with-an-unknown-result-type
//# error: UnknownType
//# diagnostics: 1
fn double(n: Int) -> Nmber => n * 2
View Main() { Text("x") }

//# case: function-called-right-is-fine
//# text: 3
fn add(a: Int, b: Int) -> Int => a + b
View Main() { Text("{add(1, 2)}") }

//# case: function-in-a-view-called-with-too-few-arguments
//# fragment
//# error: ArityMismatch
//# diagnostics: 1
fn add(a: Int, b: Int) -> Int => a + b
Text("{add(1)}")

//# case: function-calling-another-with-the-wrong-count
//# error: ArityMismatch
//# diagnostics: 1
fn one(a: Int) -> Int => a
fn two(a: Int) -> Int => one(a, a)
View Main() { Text("{two(1)}") }

//# case: function-result-int-for-float-is-a-float
//# text: 1.5
fn three() -> Float => 3
View Main() { Text("{three() / 2}") }

//# case: view-function-int-for-float-parameter-is-a-float
//# fragment
//# text: 1.5
fn half(x: Float) -> Float => x / 2
Text("{half(3)}")

//# case: named-action-called-right-is-fine
//# fragment
//# text: 2
var n = 0
let add = (by: Int) => { n += by }
on mount => add(2)
Text("{n}")

//# case: calling-a-text
//# fragment
//# error: TypeMismatch
//# diagnostics: 1
var s = "a"
Text("{s(1)}")

//# case: callback-called-with-the-right-type-is-fine
//# text: go | ready
View Go(on_done: Fn(Str) = {|_| }) {
    on mount => on_done("ready")
    Text("go")
}
View Main() {
    var state = "waiting"
    Go(on_done: {|s| state = s })
    Text(state)
}

//# case: function-positional-then-named-arguments
//# text: 1
fn sub(a: Int, b: Int) -> Int => a - b
View Main() { Text("{sub(2, b: 1)}") }

//# case: function-named-argument-it-does-not-have
//# error: UnknownParam
//# diagnostics: 1
fn sub(a: Int, b: Int) -> Int => a - b
View Main() { Text("{sub(a: 2, c: 1)}") }

//# case: function-argument-given-twice
//# error: DuplicateParam
//# diagnostics: 1
fn sub(a: Int, b: Int) -> Int => a - b
View Main() { Text("{sub(1, a: 2)}") }

//# case: function-argument-left-out-by-name
//# error: MissingParam
//# diagnostics: 1
fn sub(a: Int, b: Int) -> Int => a - b
View Main() { Text("{sub(a: 2)}") }

//# case: function-named-argument-of-the-wrong-type
//# error: ArgumentTypeMismatch
//# diagnostics: 1
fn sub(a: Int, b: Int) -> Int => a - b
View Main() { Text("{sub(b: "x", a: 2)}") }

//# case: function-named-arguments-in-a-view-function
//# text: 7
View Main() {
    fn mix(a: Int, b: Int) -> Int => a * 10 + b
    Text("{mix(b: 7, a: 0)}")
}

//# case: function-named-arguments-in-either-order
//# fragment
//# text: 3 1
fn two(a: Int, b: Int) -> Int => a - b
Text("{two(b: 1, a: 4)} {two(a: 2, b: 1)}")

//# case: function-named-arguments-for-a-named-action
//# fragment
//# text: 5
var n = 0
let add = (by: Int) => { n += by }
on mount => { add(by: 5) }
Text("{n}")

//# case: function-block-body-with-two-lets
//# text: 11
fn f(a: Int) -> Int => {
    let b = a * 2
    let c = b + 1
    c
}
View Main() { Text("{f(5)}") }

//# case: function-block-body-of-the-wrong-type
//# error: TypeMismatch
//# diagnostics: 1
fn f(a: Int) -> Str => {
    let b = a * 2
    b
}
View Main() { Text(f(1)) }

//# case: function-block-body-calls-a-function
//# text: 7
fn one() -> Int => 1
fn f(a: Int) -> Int => {
    let b = a + one()
    b * 1
}
View Main() { Text("{f(6)}") }

//# case: function-block-body-in-a-view
//# text: 9
View Main() {
    fn f(a: Int) -> Int => {
        let b = a * a
        b
    }
    Text("{f(3)}")
}

//# case: function-block-body-may-not-write
//# error: ImpureFunction
//# diagnostics: 1
fn f(a: Int) -> Int => {
    let b = a
    b = 2
    b
}
View Main() { Text("{f(1)}") }

//# case: function-body-that-is-a-record-is-still-a-record
//# text: 3
type P = { x: Int }
fn mk(a: Int) -> P => { x: a }
View Main() { Text("{mk(3).x}") }

//# case: generic-function-gives-back-what-it-was-given
//# text: A
fn first<T>(xs: List<T>) -> T => xs[0]
View Main() { Text(first(["a", "b"]).toUpper()) }

//# case: generic-function-result-has-the-type-it-was-given
//# fragment
//# error: TypeMismatch
//# diagnostics: 1
fn first<T>(xs: List<T>) -> T => xs[0]
let n: Int = first(["a"])
Text("{n}")

//# case: generic-function-with-two-parameters
//# text: x
fn pair<A, B>(a: A, b: B) -> A => a
View Main() { Text(pair("x", 1)) }

//# case: generic-function-needs-its-arguments-to-agree
//# error: ArgumentTypeMismatch
//# diagnostics: 1
fn pick<T>(a: T, b: T) -> T => a
View Main() { Text("{pick(1, "x")}") }

//# case: generic-function-values-can-be-compared
//# text: true
fn same<T>(a: T, b: T) -> Bool => a == b
View Main() { Text("{same("a", "a")}") }

//# case: generic-function-values-cannot-be-added
//# error: TypeMismatch
//# diagnostics: 1
fn add<T>(a: T, b: T) -> T => a + b
View Main() { Text("{add(1, 2)}") }

//# case: generic-function-over-a-list
//# text: 3
fn count<T>(xs: List<T>) -> Int => xs.len
View Main() { Text("{count([1, 2, 3])}") }

//# case: generic-function-in-a-view
//# text: b
View Main() {
    fn last<T>(xs: List<T>) -> T => xs[1]
    Text(last(["a", "b"]))
}

//# case: type-parameter-is-not-a-type-outside-its-function
//# error: UnknownType
//# diagnostics: 1
fn f<T>(a: T) -> Int => 1
fn g(a: T) -> Int => 1
View Main() { Text("{f(1)}") }

//# case: generic-function-with-a-type-that-is-not-there
//# error: UnknownType
//# diagnostics: 1
fn f<T>(a: U) -> Int => 1
View Main() { Text("{f(1)}") }

//# case: type-parameter-written-twice-is-one-error
//# error: UnexpectedToken
//# diagnostics: 1
fn f<T, T>(a: T) -> Int => 1
View Main() { Text("x") }
