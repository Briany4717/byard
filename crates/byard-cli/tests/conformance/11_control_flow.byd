// `when`, `else when`, `for`, `key`, and the statements of an action.

//# case: when-true-and-false
//# fragment
//# text: yes | end
when true { Text("yes") }
when false { Text("no") }
Text("end")

//# case: when-else
//# fragment
//# text: b
var on = false
when on { Text("a") } else { Text("b") }

//# case: else-when-chain
//# fragment
//# text: two
var step = 1
when step == 0 { Text("one") } else when step == 1 { Text("two") } else { Text("three") }

//# case: else-when-without-a-final-else
//# fragment
//# text: end
var step = 5
when step == 0 { Text("one") } else when step == 1 { Text("two") }
Text("end")

//# case: when-follows-state
//# fragment
//# text: shown
var on = false
on mount => { on = true }
when on { Text("shown") }

//# case: when-rebuilds-fresh-state
//# text: 0
View Counter() {
    var n = 0
    Text("{n}")
}
View Main() {
    var on = true
    on mount => { on = false on = true }
    when on { Counter() }
}

//# case: when-condition-must-be-bool
//# fragment
//# error: TypeMismatch
when 5 { Text("x") }

//# case: when-checks-the-arm-that-is-not-shown
//# fragment
//# error: UnknownName
when false { Text("{nope}") }

//# case: when-nested
//# fragment
//# text: inner
when true { when true { Text("inner") } }

//# case: else-without-when
//# fragment
//# error: UnexpectedToken
else { Text("x") }

//# case: for-nested
//# fragment
//# text: 1a | 1b | 2a | 2b
for n in [1, 2] { for s in ["a", "b"] { Text("{n}{s}") } }

//# case: for-over-records
//# fragment
//# text: Ada 3 | Bo 4
for u in [{ name: "Ada", n: 3 }, { name: "Bo", n: 4 }] { Text("{u.name} {u.n}") }

//# case: for-follows-the-list
//# fragment
//# text: a | b | c
var xs = ["a"]
on mount => { xs = xs.push("b").push("c") }
for s in xs { Text(s) }

//# case: for-variable-does-not-leak
//# fragment
//# error: UnknownName
for s in ["a"] { Text(s) }
Text(s)

//# case: for-shadows-an-outer-name
//# fragment
//# text: a | outer
let s = "outer"
for s in ["a"] { Text(s) }
Text(s)

//# case: for-over-a-map-result
//# fragment
//# text: 2 | 4
for n in [1, 2].map(x => x * 2) { Text("{n}") }

//# case: for-key
//# fragment
//# text: Ada | Bo
for name in ["Ada", "Bo"] key name { Text(name) }

//# case: for-key-with-index
//# fragment
//# text: 0 Ada | 1 Bo
for i, name in ["Ada", "Bo"] key name { Text("{i} {name}") }

//# case: for-key-keeps-row-state
//# wait: 50
//# text: New 0 | Ada 1
View Row1(name: Str) {
    var n = 0
    on mount => { if name == "Ada" { n = 1 } }
    Text("{name} {n}")
}
View Main() {
    var names = ["Ada"]
    after 1ms => { names = ["New", "Ada"] }
    for name in names key name { Row1(name) }
}

//# case: for-key-duplicate
//# fragment
//# error: DuplicateForKey
for name in ["a", "a"] key name { Text(name) }

//# case: for-key-of-a-list
//# fragment
//# error: ForKeyNotComparable
for row in [[1], [2]] key row { Text("x") }

//# case: for-key-by-record-field
//# fragment
//# text: a | b
for t in [{ id: 1, s: "a" }, { id: 2, s: "b" }] key t.id { Text(t.s) }

//# case: key-is-still-a-name
//# fragment
//# text: k
let key = "k"
Text(key)

//# case: for-with-range
//# gap: no range; a counted loop needs a list written out
//# fragment
//# text: 0 | 1 | 2
for i in 0..3 { Text("{i}") }

//# case: match-on-an-enum
//# text: b
enum S { a, b }
View Main() {
    var s = S.b
    Text(match s { .a => "a", .b => "b" })
}

//# case: match-with-the-enum-written-out
//# text: M
enum Size { small, medium, large }
View Main() {
    var size = Size.medium
    Text(match size { Size.small => "S", Size.medium => "M", Size.large => "L" })
}

//# case: match-over-lines-needs-no-commas
//# text: 2
enum S { a, b, c }
View Main() {
    var s = S.b
    let n = match s {
        .a => 1
        .b => 2
        .c => 3
    }
    Text("{n}")
}

//# case: match-with-else-covers-the-rest
//# text: other
enum S { a, b, c }
View Main() {
    var s = S.c
    Text(match s { .a => "first", else => "other" })
}

//# case: match-with-a-case-that-is-not-there
//# error: UnknownEnumCase
//# diagnostics: 1
enum S { a, b }
View Main() {
    var s = S.a
    Text(match s { .a => "a", .c => "c", .b => "b" })
}

//# case: match-names-every-case-it-leaves-out
//# error: NonExhaustive
//# diagnostics: 1
enum S { a, b, c }
View Main() {
    var s = S.a
    Text(match s { .a => "a" })
}

//# case: match-arms-of-two-types-are-one-error
//# error: TypeMismatch
//# diagnostics: 1
enum S { a, b }
View Main() {
    var s = S.a
    Text(match s { .a => "a", .b => 2 })
}

//# case: match-on-a-bool-needs-both-or-an-else
//# fragment
//# text: yes
var on = true
Text(match on { true => "yes", false => "no" })

//# case: match-on-a-bool-with-one-arm-is-not-exhaustive
//# fragment
//# error: NonExhaustive
//# diagnostics: 1
var on = true
Text(match on { true => "yes" })

//# case: match-on-an-int-needs-an-else
//# fragment
//# error: NonExhaustive
//# diagnostics: 1
var n = 2
Text(match n { 1 => "one", 2 => "two" })

//# case: match-on-an-int-with-an-else
//# fragment
//# text: many
var n = 7
Text(match n { 1 => "one", 2 => "two", else => "many" })

//# case: match-on-text
//# fragment
//# text: 2
var s = "b"
Text("{match s { "a" => 1, "b" => 2, else => 0 }}")

//# case: match-with-no-arm-is-one-error
//# fragment
//# error: UnexpectedToken
//# diagnostics: 1
var n = 2
Text("{match n { }}")

//# case: match-as-an-action
//# text: 1 | 0
enum S { up, down }
View Main() {
    var s = S.up
    var n = 0
    var m = 0
    on mount => { match s { .up => n++, .down => m++ } }
    Text("{n}")
    Text("{m}")
}

//# case: match-in-a-view-follows-the-value
//# text: B
enum S { a, b }
View Main() {
    var s = S.a
    on mount => { s = S.b }
    match s {
        .a => Text("A")
        .b => Text("B")
    }
}

//# case: match-arm-with-several-members
//# text: x | y
enum S { a, b }
View Main() {
    var s = S.a
    match s {
        .a => { Text("x") Text("y") }
        .b => Text("z")
    }
}

//# case: match-arm-draws-a-view
//# text: leaf
enum S { a, b }
View Leaf() { Text("leaf") }
View Main() {
    var s = S.b
    match s { .a => Text("no"), .b => Leaf() }
}

//# case: match-view-member-names-what-it-leaves-out
//# error: NonExhaustive
//# diagnostics: 1
enum S { a, b }
View Main() {
    var s = S.a
    match s { .a => Text("a") }
}

//# case: when-chain-with-an-else-is-not-told
//# text: c
enum S { a, b, c }
View Main() {
    var s = S.c
    when s == S.a { Text("a") } else when s == S.b { Text("b") } else { Text("c") }
}

//# case: when-chain-covering-every-case-is-not-told
//# text: b
enum S { a, b }
View Main() {
    var s = S.b
    when s == S.a { Text("a") } else when s == S.b { Text("b") }
}

//# case: a-lone-when-over-an-enum-is-not-a-chain
//# text: a
enum S { a, b, c }
View Main() {
    var s = S.a
    when s == S.a { Text("a") }
}

//# case: the-word-match-still-calls-the-anchor-width
//# fragment
//# text: ok
Text("ok")

//# case: when-chain-over-an-enum-is-not-checked-for-missing-cases
//# warning: NonExhaustive
enum S { a, b, c }
View Main() {
    var s = S.c
    when s == S.a { Text("a") } else when s == S.b { Text("b") }
}

//# case: action-if-else
//# fragment
//# text: limit
var count = 5
var message = ""
on mount => {
    let next = count + 1
    if next > 5 {
        message = "limit"
    } else {
        count = next
    }
}
Text(message)

//# case: action-else-if
//# fragment
//# text: mid
var n = 5
var s = ""
on mount => {
    if n < 3 { s = "low" } else if n < 8 { s = "mid" } else { s = "high" }
}
Text(s)

//# case: action-if-needs-braces
//# fragment
//# error: UnexpectedToken
var n = 0
on mount => { if n == 0 n = 1 }
Text("{n}")

//# case: action-let-holds-for-later-statements
//# fragment
//# text: 6
var n = 0
on mount => {
    let a = 2
    let b = a * 3
    n = b
}
Text("{n}")

//# case: action-let-does-not-leak
//# fragment
//# error: UnknownName
var n = 0
on mount => { let a = 2 }
Text("{a}")

//# case: action-statements-run-in-order
//# fragment
//# text: 3
var n = 0
on mount => { n = 1 n = n + 1 n = n + 1 }
Text("{n}")

//# case: action-single-statement-needs-no-braces
//# fragment
//# text: 1
var n = 0
on mount => n = 1
Text("{n}")

//# case: action-reads-the-value-it-just-wrote
//# fragment
//# text: 2 4
var a = 1
var b = 0
on mount => { a = 2 b = a * 2 }
Text("{a} {b}")

//# case: action-for-loop
//# gap: an action cannot loop over a list
//# fragment
//# text: 6
var n = 0
on mount => { for i in [1, 2, 3] { n += i } }
Text("{n}")

//# case: action-if-condition-must-be-bool
//# fragment
//# error: TypeMismatch
var n = 0
on mount => { if 5 { n = 1 } }
Text("{n}")

//# case: action-early-return
//# gap: an action cannot stop early
//# fragment
//# text: 1
var n = 0
on mount => {
    n = 1
    if n == 1 { return }
    n = 2
}
Text("{n}")

//# case: if-is-still-a-name
//# fragment
//# text: 3
let if = 3
Text("{if}")

//# case: clock-in-an-action
//# fragment
//# text: true
var t = ""
on mount => { t = now() }
Text("{t.len == 19}")

//# case: clock-outside-an-action
//# fragment
//# error: ClockOutsideAction
let t = now()
Text(t)

//# case: clock-in-a-function
//# error: ImpureFunction
fn stamp() -> Str => now()
View Main() { Text(stamp()) }

//# case: when-with-a-comparison-is-fine
//# fragment
//# text: shown
var n = 2
when n > 1 { Text("shown") }

//# case: if-else-condition-a-text-is-an-error
//# fragment
//# error: TypeMismatch
//# diagnostics: 1
var n = 0
on mount => {
    if "a" {
        n = 1
    } else {
        n = 2
    }
}
Text("{n}")

//# case: for-over-a-text-is-an-error
//# fragment
//# error: TypeMismatch
//# diagnostics: 1
for c in "abc" {
    Text("x")
}

//# case: enum-case-with-values-in-a-view
//# text: could not load: offline
enum Load { idle, failed(message: Str) }
View Main() {
    var state = Load.failed(message: "offline")
    match state {
        .idle => Text("idle")
        .failed(message) => Text("could not load: {message}")
    }
}

//# case: enum-case-with-two-values
//# text: 3 of 10
enum Page { empty, at(n: Int, of: Int) }
View Main() {
    let page = Page.at(n: 3, of: 10)
    Text(match page {
        .empty => "none"
        .at(n, of) => "{n} of {of}"
    })
}

//# case: enum-plain-case-beside-cases-with-values
//# text: idle
enum Load { idle, ready(count: Int) }
View Main() {
    var state = Load.idle
    Text(match state {
        .idle => "idle"
        .ready(count) => "{count}"
    })
}

//# case: enum-case-with-values-written-with-its-enum
//# text: 7
enum Load { idle, ready(count: Int) }
View Main() {
    var state = Load.ready(count: 7)
    Text(match state {
        Load.idle => "idle"
        Load.ready(count) => "{count}"
    })
}

//# case: enum-case-with-values-matched-without-reading-them
//# text: ready
enum Load { idle, ready(count: Int) }
View Main() {
    var state = Load.ready(count: 7)
    Text(match state {
        .idle => "idle"
        .ready => "ready"
    })
}

//# case: enum-case-with-values-and-an-else
//# text: not ready
enum Load { idle, loading, ready(count: Int) }
View Main() {
    var state = Load.loading
    Text(match state {
        .ready(count) => "{count}"
        else => "not ready"
    })
}

//# case: enum-case-with-values-given-to-a-view
//# text: offline
enum Load { idle, failed(message: Str) }
View Show(state: Load) {
    match state {
        .idle => Text("idle")
        .failed(message) => Text(message)
    }
}
View Main() {
    Show(state: Load.failed(message: "offline"))
}

//# case: enum-case-with-values-equal-when-their-values-are
//# text: true | false
enum Load { idle, failed(message: Str) }
View Main() {
    Text("{Load.failed(message: "a") == Load.failed(message: "a")}")
    Text("{Load.failed(message: "a") == Load.failed(message: "b")}")
}

//# case: enum-case-with-a-list-of-records
//# text: Ada | Grace
type Person = { name: Str }
enum Load { idle, ready(people: List<Person>) }
View Main() {
    var state = Load.ready(people: [{ name: "Ada" }, { name: "Grace" }])
    match state {
        .idle => Text("idle")
        .ready(people) => for p in people { Text(p.name) }
    }
}

//# case: enum-case-with-an-enum-inside
//# text: dark
enum Mode { light, dark }
enum Setting { off, on(mode: Mode) }
View Main() {
    var s = Setting.on(mode: Mode.dark)
    Text(match s {
        .off => "off"
        .on(mode) => match mode {
            .light => "light"
            .dark => "dark"
        }
    })
}

//# case: enum-case-with-values-binds-its-values-with-their-types
//# error: UnknownMethod
//# diagnostics: 1
enum Load { idle, ready(count: Int) }
View Main() {
    var state = Load.ready(count: 7)
    Text(match state {
        .idle => "idle"
        .ready(count) => count.upper()
    })
}

//# case: enum-case-with-a-value-of-the-wrong-type
//# error: TypeMismatch
//# diagnostics: 1
enum Load { idle, failed(message: Str) }
View Main() {
    var state = Load.failed(message: 3)
    Text("x")
}

//# case: enum-case-with-a-value-left-out
//# error: TypeMismatch
//# diagnostics: 1
enum Load { idle, failed(message: Str) }
View Main() {
    var state = Load.failed()
    Text("x")
}

//# case: enum-case-with-a-field-it-does-not-have
//# error: UnknownField
//# diagnostics: 1
enum Load { idle, failed(message: Str) }
View Main() {
    var state = Load.failed(message: "a", code: 1)
    Text("x")
}

//# case: enum-case-with-values-needs-them
//# error: ArityMismatch
//# diagnostics: 1
enum Load { idle, failed(message: Str) }
View Main() {
    var state = Load.failed
    Text("x")
}

//# case: enum-pattern-binds-as-many-as-the-case-carries
//# error: ArityMismatch
//# diagnostics: 1
enum Load { idle, failed(message: Str) }
View Main() {
    var state = Load.idle
    Text(match state {
        .idle => "idle"
        .failed(a, b) => a
    })
}

//# case: enum-plain-case-binds-nothing
//# error: ArityMismatch
//# diagnostics: 1
enum Load { idle, failed(message: Str) }
View Main() {
    var state = Load.idle
    Text(match state {
        .idle(x) => "idle"
        .failed(message) => message
    })
}

//# case: enum-case-with-values-left-out-of-a-match-is-named
//# error: NonExhaustive
//# diagnostics: 1
enum Load { idle, failed(message: Str), ready(count: Int) }
View Main() {
    var state = Load.idle
    Text(match state {
        .idle => "idle"
        .failed(message) => message
    })
}

//# case: enum-case-with-values-has-no-field-read
//# error: UnknownField
//# diagnostics: 1
enum Load { idle, failed(message: Str) }
View Main() {
    var state = Load.idle
    Text("{state.message}")
}

//# case: enum-case-cannot-carry-a-field-called-case
//# error: UnexpectedToken
//# diagnostics: 1
enum Load { idle, failed(case: Str) }
View Main() { Text("x") }

//# case: enum-case-with-empty-parentheses-is-one-error
//# error: UnexpectedToken
//# diagnostics: 1
enum Load { idle, failed() }
View Main() { Text("x") }
