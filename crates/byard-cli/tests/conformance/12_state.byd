// `var`, `let`, inference, annotations, reactivity and scope.

//# case: var-infers-from-its-first-value
//# fragment
//# text: 1 4.5 hi true 2
var a = 0
var b = 4.5
var c = "hi"
var d = true
var e = [1, 2]
on mount => { a = 1 }
Text("{a} {b} {c} {d} {e.len}")

//# case: var-with-annotation
//# fragment
//# text: 4.5 0
var price: Float = 4.5
var names: List<Str> = []
Text("{price} {names.len}")

//# case: var-int-literal-annotated-float-divides-as-a-float
//# fragment
//# text: 1.5
var w: Float = 3
Text("{w / 2}")

//# case: var-annotation-of-the-wrong-type
//# fragment
//# error: TypeMismatch
var n: Int = "a"
Text("{n}")

//# case: var-list-annotation-of-the-wrong-type
//# fragment
//# error: TypeMismatch
var xs: List<Int> = ["a"]
Text("{xs.len}")

//# case: var-annotation-that-is-no-type
//# fragment
//# error: UnknownType
var q: Qux = 1
Text("{q}")

//# case: var-generic-type-that-does-not-exist
//# fragment
//# error: UnknownType
var m: Dict<Str, Int> = {}
Text("x")

//# case: var-assigned-another-type
//# fragment
//# error: TypeMismatch
var n = 0
on mount => { n = "text" }
Text("{n}")

//# case: var-plus-equals-another-type
//# fragment
//# error: TypeMismatch
var n = 0
on mount => { n += "a" }
Text("{n}")

//# case: var-increment-on-text
//# fragment
//# error: TypeMismatch
var s = "a"
on mount => { s++ }
Text(s)

//# case: var-declared-twice
//# fragment
//# error: NameCollision
var x = 1
var x = 2
Text("{x}")

//# case: var-and-let-of-one-name
//# fragment
//# error: NameCollision
var x = 1
let x = 2
Text("{x}")

//# case: var-named-like-a-parameter
//# error: NameCollision
View Card(n: Int) {
    var n = 2
    Text("{n}")
}
View Main() { Card(1) }

//# case: var-and-fn-of-one-name
//# fragment
//# error: NameCollision
//# diagnostics: 1
var total = 1
fn total(x: Int) -> Int => x
Text("{total}")

//# case: var-three-times-is-two-errors-one-for-each-repeat
//# fragment
//# error: NameCollision
//# diagnostics: 2
var x = 1
var x = 2
var x = 3
Text("{x}")

//# case: name-reused-in-an-inner-body-is-fine
//# fragment
//# text: 1 | 2
var x = 1
Text("{x}")
when x == 1 {
    let x = 2
    Text("{x}")
}

//# case: the-same-name-in-two-bodies-is-fine
//# fragment
//# text: a | b
var on = true
when on {
    let word = "a"
    Text(word)
} else {
    let word = "b"
    Text(word)
}
when !on {
    Text("never")
} else {
    let word = "b"
    Text(word)
}

//# case: var-unused
//# fragment
//# warning: UnusedVariable
var unused = 0
Text("x")

//# case: var-unused-in-a-when-body
//# fragment
//# warning: UnusedVariable
var on = true
when on {
    let spare = 1
    Text("x")
}

//# case: let-unused
//# fragment
//# warning: UnusedVariable
let spare = 1
Text("x")

//# case: unused-name-with-an-underscore-is-meant
//# fragment
//# text: x
var _spare = 0
let _other = 1
Text("x")

//# case: param-unused
//# warning: UnusedParam
View Card(label: Str) { Text("x") }
View Main() { Card("a") }

//# case: param-unused-with-an-underscore-is-meant
//# text: x
View Card(_label: Str) { Text("x") }
View Main() { Card("a") }

//# case: param-read-only-in-a-default-is-read
//# text: 5
View Card(n: Int, double: Int = n * 2 - 3) { Text("{double}") }
View Main() { Card(4) }

//# case: private-view-nobody-draws
//# warning: UnusedView
private View Hidden() { Text("h") }
View Main() { Text("m") }

//# case: private-view-that-is-drawn
//# text: h
private View Hidden() { Text("h") }
View Main() { Hidden() }

//# case: var-used-before-its-line
//# fragment
//# text: 5
Text("{n}")
var n = 5

//# case: var-inside-an-element-body
//# fragment
//# error: LetInElementBody
Column {
    var n = 3
    Text("{n}")
}

//# case: var-inside-an-element-body-does-not-leak
//# fragment
//# error: UnknownName
Column { var n = 3 }
Text("{n}")

//# case: var-initializer-reads-another-var
//# fragment
//# text: 2
var a = 1
var b = a + 1
Text("{b}")

//# case: var-initializer-is-read-once
//# fragment
//# text: 2
var a = 1
var b = a + 1
on mount => { a = 10 }
Text("{b}")

//# case: let-is-derived
//# fragment
//# text: 20
var a = 1
let b = a * 2
on mount => { a = 10 }
Text("{b}")

//# case: let-of-let
//# fragment
//# text: 22
var a = 1
let b = a * 2
let c = b + 2
on mount => { a = 10 }
Text("{c}")

//# case: let-with-annotation
//# fragment
//# text: 3
let n: Int = 3
Text("{n}")

//# case: let-annotation-of-the-wrong-type
//# fragment
//# error: TypeMismatch
let z: Str = 5
Text(z)

//# case: let-cycle
//# fragment
//# error: ConstantCycle
let a = b + 1
let b = a + 1
Text("{a}")

//# case: let-cycle-of-three-is-one-error
//# fragment
//# error: ConstantCycle
//# diagnostics: 1
let a = c + 1
let b = a + 1
let c = b + 1
Text("{b}")

//# case: let-reading-the-one-before-is-not-a-cycle
//# fragment
//# text: 3
let a = 1
let b = a + 1
let c = b + 1
Text("{c}")

//# case: let-cycle-does-not-hang
//# fragment
//# text: ok
let a = b + 1
let b = a + 1
Text("ok")

//# case: unknown-name
//# fragment
//# error: UnknownName
Text("{nope}")

//# case: unknown-name-in-an-attribute
//# fragment
//# error: UnknownName
Text("a") #[size: nope]

//# case: unknown-name-in-an-action
//# fragment
//# error: UnknownName
on mount => { nope = 1 }
Text("a")

//# case: built-in-names
//# fragment
//# text: true true
Text("{window.width > 0} {window.height > 0}")

//# case: text-interpolation-follows-state
//# fragment
//# text: 2 taps
var count = 0
on mount => { count = 2 }
Text("{count} taps")

//# case: attribute-follows-state
//# fragment
//# text: ok
var big = false
on mount => { big = true }
Text("ok") #[size: big ? 30 : 12]

//# case: write-of-the-same-value-is-not-a-change
//# fragment
//# text: 0
var a = 1
var seen = 0
on change(a) => { seen++ }
on mount => { a = 1 }
Text("{seen}")

//# case: on-change-runs-when-the-value-changes
//# fragment
//# wait: 50
//# text: 1
var a = 1
var seen = 0
on change(a) => { seen++ }
after 10ms => { a = 2 }
Text("{seen}")

//# case: on-change-of-several
//# fragment
//# wait: 50
//# text: true
var a = 1
var b = 1
var seen = 0
on change(a, b) => { seen++ }
after 10ms => { a = 2 b = 2 }
Text("{seen >= 1}")

//# case: on-change-that-writes-what-it-watches-settles
//# fragment
//# text: ok
var a = 0
on change(a) => { if a < 3 { a = a + 1 } }
on mount => { a = 1 }
Text("ok")

//# case: on-mount-runs-once
//# fragment
//# text: 1
var n = 0
on mount => { n++ }
Text("{n}")

//# case: on-unmount-is-accepted
//# fragment
//# text: a
var n = 0
on unmount => { n++ }
Text("a")

//# case: timers-are-accepted
//# fragment
//# text: a
var n = 0
every 1s => { n++ }
after 300ms => { n++ }
Text("a")

//# case: timer-with-an-expression
//# fragment
//# text: a
var wait = 5
var n = 0
after wait * 1ms => { n++ }
Text("a")

//# case: timer-of-zero
//# fragment
//# error: InvalidAnimation
var n = 0
every 0ms => { n++ }
Text("a")

//# case: after-zero-is-refused-too
//# fragment
//# error: InvalidAnimation
//# diagnostics: 1
var n = 0
after 0ms => { n++ }
Text("{n}")

//# case: on-change-does-not-see-what-mount-wrote
//# fragment
//# text: 0
var a = 1
var seen = 0
on change(a) => { seen++ }
on mount => { a = 2 }
Text("{seen}")

//# case: after-runs-once
//# fragment
//# wait: 400
//# text: 1
var n = 0
after 100ms => { n++ }
Text("{n}")

//# case: every-repeats
//# fragment
//# wait: 350
//# text: 3
var n = 0
every 100ms => { n++ }
Text("{n}")

//# case: every-first-fires-after-its-interval
//# fragment
//# wait: 50
//# text: 0
var n = 0
every 100ms => { n++ }
Text("{n}")

//# case: timer-inside-a-when-stops-with-it
//# fragment
//# wait: 500
//# text: 1
var n = 0
var live = true
after 150ms => { live = false }
when live { every 100ms => { n++ } }
Text("{n}")

//# case: float-var-assigned-an-int-stays-a-float
//# fragment
//# text: 1.5
var w = 0.5
on mount => { w = 3 }
Text("{w / 2}")

//# case: list-of-floats-written-with-ints-holds-floats
//# fragment
//# text: 0.5
var xs: List<Float> = [1, 2]
Text("{xs[0] / 2}")

//# case: float-var-plus-equals-an-int-adds-as-a-float
//# fragment
//# text: 1.5
var x: Float = 0.5
on mount => { x += 1 }
Text("{x}")

//# case: int-var-plus-equals-a-float-is-an-error
//# fragment
//# error: TypeMismatch
//# diagnostics: 1
var n = 0
on mount => { n += 0.5 }
Text("{n}")

//# case: text-var-plus-equals-is-an-error
//# fragment
//# error: TypeMismatch
//# diagnostics: 1
var s = "a"
on mount => { s += "b" }
Text(s)

//# case: one-list-item-of-the-wrong-type-is-one-error
//# fragment
//# error: TypeMismatch
//# diagnostics: 1
var xs: List<Int> = [1, "a", 3]
Text("{xs.len}")

//# case: let-in-an-action-of-the-wrong-type
//# fragment
//# error: TypeMismatch
//# diagnostics: 1
var n = 0
on mount => {
    let z: Int = "a"
    n = 1
}
Text("{n}")

//# case: binding-assigned-another-type
//# error: TypeMismatch
//# diagnostics: 1
View Inner(bind n: Int) { Button("x") => n = "a" }
View Main() {
    var n = 0
    Inner(bind: n)
    Text("{n}")
}

//# case: int-var-assigned-an-int-and-a-float-var-an-int-are-fine
//# fragment
//# text: 3 | 2
var n = 1
var f = 0.5
on mount => {
    n = 3
    f = 2
}
Text("{n}")
Text("{f}")

//# case: misspelt-type-suggests-the-nearest
//# error: UnknownType
//# diagnostics: 1
type Place = { name: Str }
View Main() {
    var p: Plac = { name: "Oslo" }
    Text("x")
}

//# case: unknown-type-inside-a-list-type
//# fragment
//# error: UnknownType
//# diagnostics: 1
var xs: List<Nope> = []
Text("{xs.len}")

//# case: unknown-type-of-a-lambda-parameter
//# fragment
//# error: UnknownType
//# diagnostics: 1
let xs = [1, 2]
Text("{xs.map((x: Nope) => x).len}")

//# case: declared-types-and-the-built-in-ones-are-types
//# text: Oslo small 3 1
type Place = { name: Str }
enum Size { small, large }
View Main() {
    var p: Place = { name: "Oslo" }
    var s: Size = Size.small
    var n: Color = 3
    var xs: List<Place> = [p]
    Text("{p.name} {s} {n} {xs.len}")
}

//# case: store-starts-at-its-default
//# text: 5
store Counter { n: Int = 5 }
View Main() {
    inject Counter as c
    Text("{c.n}")
}

//# case: store-is-one-for-the-whole-program
//# text: 2
store Session { count: Int = 0 }
View Bump() {
    inject Session as s
    on mount => { s.count++ }
    Box {}
}
View Main() {
    inject Session as s
    Bump()
    Bump()
    Text("{s.count}")
}

//# case: store-field-is-written-with-an-operator
//# text: 7
store Counter { n: Int = 5 }
View Main() {
    inject Counter as c
    on mount => { c.n += 3  c.n-- }
    Text("{c.n}")
}

//# case: store-field-may-be-nothing
//# text: Guest
type User = { name: Str }
store Session { user: User? = none }
View Main() {
    inject Session as s
    Text("{s.user?.name ?? "Guest"}")
}

//# case: store-field-set-in-one-view-is-read-in-another
//# text: Ada
type User = { name: Str }
store Session { user: User? = none }
View Reader() {
    inject Session as s
    Text("{s.user?.name ?? "Guest"}")
}
View Main() {
    inject Session as s
    on mount => { s.user = { name: "Ada" } }
    Reader()
}

//# case: store-field-is-set-back-to-nothing
//# text: Guest
type User = { name: Str }
store Session { user: User? = none }
View Main() {
    inject Session as s
    on mount => { s.user = { name: "Ada" }  s.user = none }
    Text("{s.user?.name ?? "Guest"}")
}

//# case: store-field-written-with-a-wrong-type
//# error: TypeMismatch
//# diagnostics: 1
store Counter { n: Int = 5 }
View Main() {
    inject Counter as c
    on mount => { c.n = "a" }
    Text("{c.n}")
}

//# case: store-field-it-does-not-have
//# error: UnknownField
//# diagnostics: 1
store Counter { n: Int = 5 }
View Main() {
    inject Counter as c
    on mount => { c.m = 1 }
    Text("{c.n}")
}

//# case: store-field-needs-a-default
//# error: ContextFieldNeedsDefault
//# diagnostics: 1
store Counter { n: Int }
View Main() {
    inject Counter as c
    Text("{c.n}")
}

//# case: store-is-not-provided
//# error: StoreProvided
//# diagnostics: 1
store Counter { n: Int = 5 }
View Main() {
    provide Counter(n: 1)
    Text("x")
}

//# case: store-with-an-enum-field
//# text: system
enum Scheme { system, light, dark }
store Prefs { scheme: Scheme = .system }
View Main() {
    inject Prefs as p
    Text("{p.scheme}")
}

//# case: store-persist-is-not-available-yet
//# error: UnexpectedToken
//# diagnostics: 1
store Session persist "session" { n: Int = 0 }
View Main() { Text("x") }

//# case: store-is-still-a-name
//# fragment
//# text: 3
let store = 3
Text("{store}")
