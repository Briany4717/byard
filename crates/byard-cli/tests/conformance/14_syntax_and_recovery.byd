fn f(x: Int) -> Int
View Main() { Text("a") }

//# case: fn-with-a-brace-body-and-no-arrow
//# error: UnexpectedToken
fn f(x: Int) -> Int { x }
View Main() { Text("a") }

//# case: type-without-braces
//# error: UnexpectedToken
type P = Int
View Main() { Text("a") }

//# case: enum-with-a-value
//# error: UnexpectedToken
enum E { a = 1 }
View Main() { Text("a") }

//# case: binary-operator-without-a-right-side
