Text("{[1].map(x => x}")

//# case: list-unclosed
//# fragment
//# error: UnexpectedToken
let xs = [1, 2
Text("a")

//# case: record-unclosed
//# fragment
//# error: UnexpectedToken
let r = { a: 1
Text("a")

//# case: record-field-without-a-value
//# fragment
//# error: UnexpectedToken
let r = { a: }
Text("a")

//# case: for-without-in
//# fragment
//# error: UnexpectedToken
for x [1] { Text("a") }

//# case: for-without-a-body
//# fragment
//# error: UnexpectedToken
for x in [1]
Text("a")

//# case: when-without-a-condition
//# fragment
//# error: UnexpectedToken
when { Text("a") }

//# case: when-without-a-body
//# fragment
//# error: UnexpectedToken
when true
Text("a")

//# case: lambda-without-a-body
//# fragment
//# error: UnexpectedToken
let f = (x: Int) =>
Text("a")

//# case: double-operator
//# fragment
//# error: UnexpectedToken
Text("{1 * / 2}")

//# case: one-mistake-is-one-error-in-a-call
//# fragment
//# error: UnexpectedToken
//# diagnostics: 1
Text(match 1 { })

//# case: parameter-without-a-name
//# error: UnexpectedToken
View Card(: Str) { Text("a") }
View Main() { Card("a") }

//# case: parameter-list-unclosed
//# error: UnexpectedToken
View Card(a: Str { Text("a") }
View Main() { Card("a") }

//# case: generic-type-unclosed
//# fragment
//# error: UnexpectedToken
var xs: List<Int = []
Text("a")

//# case: only-a-comment
