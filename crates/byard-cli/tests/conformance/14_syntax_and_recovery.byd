// Malformed programs: each is one mistake and should be one error, and none
// may panic the parser or the checker.

//# covers: one-mistake-one-error, source-text

//# case: view-without-a-body
//# error: UnexpectedToken
View Main()

//# case: view-without-parentheses
//# error: UnexpectedToken
View Main { Text("a") }

//# case: unclosed-view-brace
//# error: UnexpectedToken
View Main() { Text("a")

//# case: extra-closing-brace
//# error: UnexpectedToken
View Main() { Text("a") } }

//# case: stray-token-at-the-top
//# error: UnexpectedToken
hello
View Main() { Text("a") }

//# case: use-after-a-view
//# error: ImportAfterView
//# error: UnknownPackage
View Main() { Text("a") }
use kit

//# case: use-of-an-unknown-package
//# error: UnknownPackage
use kit
View Main() { Text("a") }

//# case: var-without-a-value
//# fragment
//# error: UnexpectedToken
var n
Text("a")

//# case: var-without-a-name
//# fragment
//# error: UnexpectedToken
var = 5
Text("a")

//# case: let-without-a-value
//# fragment
//# error: UnexpectedToken
let n: Int
Text("a")

//# case: fn-without-a-body
