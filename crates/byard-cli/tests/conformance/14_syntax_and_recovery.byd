Text("{"{"{"{"{"{"{"{"{"{"{"{"{"{"{"{"{"{"{"{"{"{"{"{"{"{"{"{"{"{"{"{"x"}"}"}"}"}"}"}"}"}"}"}"}"}"}"}"}"}"}"}"}"}"}"}"}"}"}"}"}"}"}"}"}")

//# case: control-character
//# fragment
//# error: UnexpectedChar
Text("a") 

//# case: byte-order-mark-at-the-start
//# text: a
﻿View Main() { Text("a") }

//# case: stray-character-in-a-call
//# fragment
//# error: UnexpectedChar
//# diagnostics: 1
Text(@)

//# case: duration-too-large-is-one-error
//# fragment
//# error: UnexpectedChar
//# diagnostics: 1
Text("{99999999999ms}")

//# case: word-with-a-foreign-letter-in-a-call-is-one-error
//# fragment
//# error: UnexpectedChar
//# diagnostics: 1
Text(señal)

//# case: unterminated-string-swallows-the-rest-and-is-one-error
//# fragment
//# error: UnterminatedString
//# diagnostics: 1
Text("abc
Text(1)

//# case: attribute-with-equals-leaves-the-next-attribute-alone
//# fragment
//# error: WrongAttributeSeparator
//# diagnostics: 1
Box #[width = 100, height: 20]

//# case: call-missing-its-close-paren-is-one-error
//# fragment
//# error: UnexpectedToken
//# diagnostics: 1
Text("a"

//# case: call-with-junk-before-its-close-paren-is-one-error
//# fragment
//# error: UnexpectedToken
//# diagnostics: 1
Text("a" 1 2 (3) { 4 })

//# case: type-without-braces-does-not-hide-the-next-type
//# error: UnexpectedToken
//# diagnostics: 2
type P = Int
type Q = Int
View Main() { Text("a") }

//# case: lambda-body-on-the-next-line-is-a-body
//# fragment
//# text: 3
let f = (x: Int) =>
    x + 1
Text("{f(2)}")

//# case: lambda-without-a-body-before-a-box
//# fragment
//# error: UnexpectedToken
//# diagnostics: 1
let f = () =>
Box { Text("a") }
