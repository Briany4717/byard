{
  "name": "byld",
  "displayName": "Byld",
  "description": "Byld (.byd) language support: syntax highlighting, diagnostics, completion, formatting and rename through the byld-lsp language server.",
  "version": "0.1.0",
  "publisher": "byard",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Briany4717/byard.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://byard.dev",
  "bugs": {
    "url": "https://github.com/Briany4717/byard/issues"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "byld",
    "byard",
    "byd",
    "ui",
    "language server",
    "lsp"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#3c4048",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "activationEvents": [
    "onLanguage:byld"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "byld",
        "aliases": [
          "Byld",
          "byld"
        ],
        "extensions": [
          ".byd"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file-light.svg",
          "dark": "./images/file-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "byld",
        "scopeName": "source.byld",
        "path": "./syntaxes/byld.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[byld]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      }
    },
    "configuration": {
      "type": "object",
      "title": "Byld configuration",
      "properties": {
        "byld.lsp.serverPath": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "markdownDescription": "Path to the `byld-lsp` executable. When empty, the extension looks for `byld-lsp` on `PATH`, then in `~/.cargo/bin`, then in a `target/` folder of the workspace. Install it with `cargo install byld-lsp`."
        },
        "byld.lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Byld language server."
        }
      }
    },
    "commands": [
      {
        "command": "byld.restartServer",
        "title": "Restart Language Server",
        "category": "Byld"
      }
    ]
  },
  "scripts": {
    "test": "vscode-test",
    "vscode:prepublish": "npm run build",
    "compile": "tsc --noEmit -p .",
    "watch": "tsc --noEmit -w -p .",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.15.11",
    "@types/vscode": "^1.75.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.17.15",
    "typescript": "^5.0.4"
  }
}
