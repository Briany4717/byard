// Weather codes in words, shared by every screen. Top-level
// functions: pure, visible to every view of the project.

// The WMO weather code, in words.
fn describe(code: Int) -> Str => code == 0 ? "Clear sky"
    : code <= 2 ? "Partly cloudy"
    : code == 3 ? "Overcast"
    : code <= 48 ? "Fog"
    : code <= 57 ? "Drizzle"
    : code <= 67 ? "Rain"
    : code <= 77 ? "Snow"
    : code <= 82 ? "Showers"
    : code <= 86 ? "Snow showers"
    : "Thunderstorm"

// The same, short enough for a row: two words shorter where it matters.
fn sky(code: Int) -> Str => code == 0 ? "Clear" : code >= 95 ? "Storms" : describe(code)
