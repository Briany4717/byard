// Byld has no way to turn text into a number, so these read the digits
// themselves. A field's text is a `Str`; a quantity or a price is read from it
// here and nowhere else.

// Whether `s` is one or more digits and nothing else: "12", not "-1" or "1a".
fn isWhole(s: Str) -> Bool => s.len > 0 && s.split("").filter(c => "0123456789".indexOf(c) < 0).len == 0

// The whole number `s` spells, or 0 when it is not one.
fn toInt(s: Str) -> Int => isWhole(s) ? s.split("").reduce(0, (acc, c) => acc * 10 + "0123456789".indexOf(c)) : 0

// Whether `s` is digits with at most one point and digits on both sides of it
// when there is one: "4", "4.5", not ".5", "4." or "4.5.1".
fn isDecimal(s: Str) -> Bool => s.split(".").len == 1 ? isWhole(s) : s.split(".").len == 2 && isWhole(s.split(".")[0]) && isWhole(s.split(".")[1])

// The decimal number `s` spells, or 0.0.
fn toFloat(s: Str) -> Float => isDecimal(s) ? toInt(s.split(".")[0]) * 1.0 + (s.split(".").len == 2 ? toInt(s.split(".")[1]) / pow10(s.split(".")[1]) : 0.0) : 0.0

// Ten to the power of the number of characters in `digits`. (There is no
// recursion and no loop in a function, so a list of the characters is folded.)
fn pow10(digits: Str) -> Float => digits.split("").reduce(1.0, (acc, c) => acc * 10.0)
